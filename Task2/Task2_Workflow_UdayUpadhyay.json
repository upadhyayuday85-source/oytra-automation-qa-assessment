{
  "name": "Task2_Morning_Brief_UdayUpadhyay",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "name": "Every 1 hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://api.github.com/search/repositories?q=topic:automation&sort=stars&order=desc&per_page=10",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-morning-brief"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "name": "Search GitHub repos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        200
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.first().json.items || [];\nconst repos = items.slice(0, 5).map(r => ({\n  full_name: r.full_name,\n  stars: r.stargazers_count,\n  url: r.html_url,\n  description: r.description || 'No description'\n}));\nreturn [{ json: { repos, top: repos[0] || null } }];"
      },
      "name": "Top 5 repos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.top.full_name }}/languages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-morning-brief"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "name": "Top repo languages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        100
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const base = $('Top 5 repos').first().json;\nconst first = $input.first().json || {};\nconst failed = first.error || Object.keys(first).length === 0;\nlet langLine = 'Languages: unavailable (language API call failed)';\nif (!failed) {\n  const total = Object.values(first).reduce((a, b) => a + b, 0);\n  const top3 = Object.entries(first)\n    .sort((a, b) => b[1] - a[1])\n    .slice(0, 3)\n    .map(([k, v]) => `${k} ${Math.round((v / total) * 100)}%`);\n  langLine = 'Languages: ' + top3.join(', ');\n}\nconst lines = base.repos.map((r, i) => `${i + 1}. ${r.full_name} - ${r.stars} stars\\n   ${r.url}`);\nconst topName = base.top ? base.top.full_name : 'n/a';\nconst message = `GitHub Automation Digest\\n${lines.join('\\n')}\\n\\nTop repo: ${topName}\\n${langLine}`;\nreturn [{ json: { message, topStars: base.top ? base.top.stars : 0, topRepo: topName } }];"
      },
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "45ab7673-eb5e-4000-b62f-5cf2a5254ec6",
              "leftValue": "={{ $json.topStars }}",
              "rightValue": 100000,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Top repo over 100k stars?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        100
      ]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ 'HOT (top repo above 100k stars)\\n' + $json.message }}",
        "options": {}
      },
      "name": "Send HOT digest",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1320,
        20
      ],
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_ME",
          "name": "Discord Webhook account"
        }
      }
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ 'Daily digest\\n' + $json.message }}",
        "options": {}
      },
      "name": "Send normal digest",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1320,
        180
      ],
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_ME",
          "name": "Discord Webhook account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json || {};\nconst reason = (e.error && (e.error.message || JSON.stringify(e.error))) || e.message || 'Unknown error';\nreturn [{ json: { message: `WARNING - Morning brief: the GitHub search API call failed.\\nReason: ${reason}` } }];"
      },
      "name": "Format error message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        320
      ]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.message }}",
        "options": {}
      },
      "name": "Send error alert",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        660,
        320
      ],
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_ME",
          "name": "Discord Webhook account"
        }
      }
    }
  ],
